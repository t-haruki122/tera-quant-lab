APP_ENV=production
# 例に従って32文字以上のランダムな値に設定します。
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:////var/lib/tera-quant-lab/stock_data.db
# LANから直接接続する場合は 0.0.0.0 に変更します。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# API ドキュメントを公開しない場合は false にします。
DOCS_ENABLED=true
# yfinance のキャッシュ先は systemd ユニットの /var/cache/tera-quant-lab が既定です。
CORS_ORIGINS=
# 同じコンテナ上の nginx を経由する場合は 127.0.0.1 を指定します。
TRUSTED_PROXIES=
HSTS_ENABLED=false
