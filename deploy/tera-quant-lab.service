[Unit]
Description=Tera Quant Lab
After=network-online.target
Wants=network-online.target

[Service]
User=tera-quant-lab
Group=tera-quant-lab
WorkingDirectory=/opt/tera-quant-lab
EnvironmentFile=/etc/tera-quant-lab.env
Environment=PYTHONUNBUFFERED=1
Environment=YFINANCE_CACHE_DIR=/var/cache/tera-quant-lab
ExecStart=/opt/tera-quant-lab/.venv/bin/python -m app
Restart=on-failure
RestartSec=5s
StateDirectory=tera-quant-lab
CacheDirectory=tera-quant-lab
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tera-quant-lab
PrivateTmp=true

[Install]
WantedBy=multi-user.target
