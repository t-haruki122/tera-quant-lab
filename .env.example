# Database
DATABASE_URL=sqlite+aiosqlite:///./stock_data.db

# Authentication: replace with a strong private random value before deployment.
# production では既定値と32文字未満のキーでの起動を拒否します。
APP_ENV=development
SECRET_KEY=development-only-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
USER_IMPORT_MAX_BYTES=1048576

# CORS: 同一オリジンでは空欄。別オリジンを許可する場合はカンマ区切り（JSON配列も可）。
# Cookie等の資格情報は許可しません。許可先は必要なオリジンだけに限定してください。
CORS_ORIGINS=
# CORS_ORIGINS=http://localhost:5173, http://localhost:3000

# 認証のレート制限（プロセス内メモリ、秒単位のスライディングウィンドウ）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# データ取得と Web バックテストの乱用防止（認証済みはユーザー単位、匿名はIP単位）。利用量の割り当てには使いません。
RATE_LIMIT_DATA_REQUESTS=600
RATE_LIMIT_DATA_WINDOW_SECONDS=60
WATCHLIST_SUMMARY_CONCURRENCY=8
HISTORY_MAX_SPAN_YEARS=20

# Cache retention (days)
CACHE_RETENTION_DAYS=30
# 空欄なら yfinance 既定の場所を使います。指定先にはサービスの書き込み権限が必要です。
YFINANCE_CACHE_DIR=
STATS_FLUSH_SECONDS=60

# Web バックテスト
BACKTEST_MAX_SPAN_YEARS=20
BACKTEST_GRID_MAX_COMBOS=100
BACKTEST_TIMEOUT_SECONDS=30
BACKTEST_MAX_CONCURRENT_PER_USER=1

# Cache TTL (seconds)
CACHE_TTL_CURRENT_PRICE=60
CACHE_TTL_HISTORY=86400
CACHE_TTL_FINANCIALS=7776000
CACHE_TTL_NEWS=600

# Server
# LAN に直接公開する LXC では 0.0.0.0 を指定します。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# 本番環境で API ドキュメントと OpenAPI 定義を非公開にする場合は false にします。
DOCS_ENABLED=true
# 信頼するリバースプロキシのIP/CIDRをカンマ区切りで指定します。空欄は転送ヘッダーを無視します。
TRUSTED_PROXIES=
# HTTPS で公開するときだけ true にします。
HSTS_ENABLED=false
# 空欄は既定のCSPを使用します。指定するとヘッダー全体を上書きします。
CONTENT_SECURITY_POLICY=
